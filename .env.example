# FactoryFlow AI — Deduction Coder :: example environment
# Copy to .env and fill in real values only in your OWN private deployment.
# NEVER commit a real .env. The demo needs NONE of these — it runs fully offline.

# --- PDF extraction backend (optional) ------------------------------------
# Set to "pdfplumber" to parse real-world PDFs (pip install pdfplumber).
FACTORYFLOW_PDF_BACKEND=

# --- Email source (choose one when wiring a real inbox) -------------------
# IMAP
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Microsoft Graph (Office 365 / Outlook)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_USER_ID=

# Gmail API
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=

# --- ERP (choose one) -----------------------------------------------------
# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=

# NetSuite
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# SAP (S/4HANA OData)
SAP_BASE_URL=
SAP_USERNAME=
SAP_PASSWORD=

# --- Accounting (if different from ERP) -----------------------------------
ACCOUNTING_PROVIDER=mock
